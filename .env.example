TIKTOK_USERNAME=
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
# replay cooldown per scene setelah selesai diputar (ms), default 120000
SCENE_REPLAY_COOLDOWN_MS=120000

# ===== AutoPIN (AP0, standalone CLI — belum terhubung ke bot) =====
# toko/akun yang BOLEH diklik; wajib persis sama dengan identitas yang terlihat di LIVE console
AUTOPIN_EXPECTED_SHOP=
# identitas yang mengandung kata ini dianggap produksi dan TIDAK PERNAH diklik (pisahkan dengan koma)
AUTOPIN_FORBIDDEN_SHOPS=garudafood
AUTOPIN_CONSOLE_URL=https://shop.tiktok.com/streamer/live-console
AUTOPIN_PROFILE_DIR=.autopin-profile
AUTOPIN_DEBUG_DIR=.autopin-debug
# opsional: pakai Chrome sistem, mis. /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
AUTOPIN_CHROME_PATH=

TIKTOK_USERNAME=
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
# replay cooldown per scene setelah selesai diputar (ms), default 120000
SCENE_REPLAY_COOLDOWN_MS=120000

# ===== AutoPIN (AP0, standalone CLI — belum terhubung ke bot) =====
# toko/akun yang BOLEH diklik; wajib persis sama dengan identitas yang terlihat di LIVE console
AUTOPIN_EXPECTED_SHOP=
# identitas yang mengandung kata ini dianggap produksi dan TIDAK PERNAH diklik (pisahkan dengan koma)
AUTOPIN_FORBIDDEN_SHOPS=garudafood
# halaman yang TERVERIFIKASI punya tombol Pin per produk saat LIVE berjalan
AUTOPIN_CONSOLE_URL=https://shop.tiktok.com/streamer/live/product/dashboard
AUTOPIN_PROFILE_DIR=.autopin-profile
AUTOPIN_DEBUG_DIR=.autopin-debug
# opsional: pakai Chrome sistem, mis. /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
AUTOPIN_CHROME_PATH=

# ===== AutoPIN AP2 (integrasi dengan playback scene) =====
# Gerbang utama. Selama false: NOL aksi browser/jaringan dan playback scene
# berjalan persis seperti sebelum AutoPIN ada.
AUTOPIN_ENABLED=false
# service AutoPIN (proses terpisah: node autopin-service.js)
AUTOPIN_PORT=5055
# batas waktu satu permintaan pin (ms); habis waktu = dicatat gagal, playback jalan terus
AUTOPIN_TIMEOUT_MS=8000

# Pemetaan scene -> KUNCI JUDUL produk. WAJIB eksplisit; nomor posisi tidak
# pernah dipakai karena posisinya bergeser (lihat autopin/VERIFICATION.md).
# Isi dengan potongan judul yang UNIK di daftar produk LIVE. Kosong = scene itu
# tidak pernah dipin. MAIN tidak bisa dipetakan.
AUTOPIN_PRODUCT_PAX_1=
AUTOPIN_PRODUCT_PAX_2=
AUTOPIN_PRODUCT_PAX_3=
AUTOPIN_PRODUCT_PAX_4=
AUTOPIN_PRODUCT_PAX_5=
AUTOPIN_PRODUCT_PAX_6=
AUTOPIN_PRODUCT_PAX_7=
AUTOPIN_PRODUCT_PAX_8=
AUTOPIN_PRODUCT_PAX_9=
AUTOPIN_PRODUCT_PAX_10=

# ===== AutoComment AR1 (inti saja; transport dry-run, TIDAK mengirim apa pun) =====
# Gerbang utama. Selama false: nol pemanggilan transport, nol efek keluar.
AUTOCOMMENT_ENABLED=false
# Batas internal yang KONSERVATIF, BUKAN limit resmi TikTok (angka resminya tidak diketahui).
# Saat tercapai pesan DIBUANG, bukan diantrekan.
AUTOCOMMENT_MAX_PER_MINUTE=6
AUTOCOMMENT_MIN_INTERVAL_MS=5000
# batas waktu satu permintaan (ms); habis waktu = dicatat gagal, playback jalan terus
AUTOCOMMENT_TIMEOUT_MS=8000
# Mode transport AutoComment:
#   dry-run  = service HANYA memeriksa komposer chat; tidak pernah mengetik
#              maupun mengklik. Ini default, dan ini yang aman.
#   browser  = AutoComment boleh mengetik + satu klik, TAPI hanya setelah pin
#              TERKONFIRMASI, dan hanya kalau service dijalankan dengan
#              --enable-autocomment-send. Nilai di berkas ini SAJA tidak pernah
#              cukup untuk mengirim apa pun ke penonton.
# Nilai yang tidak dikenal jatuh ke dry-run dan diperingatkan.
AUTOCOMMENT_TRANSPORT=dry-run
